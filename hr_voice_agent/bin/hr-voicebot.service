[Unit]
Description=Agentic HR Voice Bot (LiveKit Agent)
After=network.target mysql.service asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=eoxys
Group=eoxys
WorkingDirectory=/home/eoxys/RK/AgenticHRVoiceBot
ExecStart=/home/eoxys/RK/AgenticHRVoiceBot/.venv/bin/python main.py start
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
