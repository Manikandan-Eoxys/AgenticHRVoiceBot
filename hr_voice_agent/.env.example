# =====================================================
# LIVEKIT CLOUD CONFIGURATION
# =====================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# =====================================================
# SPEECH-TO-TEXT & TEXT-TO-SPEECH (DEEPGRAM / CARTESIA)
# =====================================================
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

CARTESIA_API_KEY=your-cartesia-api-key
TTS_PROVIDER=cartesia
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=standard-female

# =====================================================
# LLM CONFIGURATION (OLLAMA / CLOUD)
# =====================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it

# =====================================================
# MYSQL DATABASE
# =====================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hrbot
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=hr_voicebot

# =====================================================
# TELEPHONY & SIP (PLIVO / ASTERISK)
# =====================================================
COORDINATOR_PHONE_NUMBER=+918925355704
LIVEKIT_OUTBOUND_TRUNK_ID=ST_your_trunk_id
SIP_CALLER_ID=+918031451001
SIP_TRUNK_USERNAME=AgenticHRVoicebot
SIP_TRUNK_PASSWORD=your-sip-password

# =====================================================
# EMAIL & NOTIFICATIONS (SMTP / IMAP)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
HR_EMAIL=hr@company.com

# =====================================================
# WORKER DISPATCH
# =====================================================
WORKER_AGENT_NAME=hr-voice-agent
IDLE_HANGUP_SECONDS=60.0
RECORDING_COORDINATOR_MODE=record_all
