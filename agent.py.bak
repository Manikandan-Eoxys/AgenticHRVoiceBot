    @function_tool()
    async def escalate_grievance(
        self,
        context: RunContext,
        grievance_id: int,
    ):
        # -------------------------
        # Authentication Check
        # -------------------------
        if not self.auth.authenticated:
            return {
                "success": False,
                "message": "Please verify your identity first by providing your employee ID."
