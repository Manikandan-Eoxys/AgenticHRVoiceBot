# =====================================================
# SPEECH-TO-TEXT (DEEPGRAM)
# =====================================================
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# =====================================================
# TEXT-TO-SPEECH (CARTESIA)
# =====================================================
CARTESIA_API_KEY=your-cartesia-api-key
TTS_PROVIDER=cartesia
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=standard-female

# =====================================================
# LLM CONFIGURATION (OLLAMA / CLOUD FALLBACK)
# =====================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
LLM_MODEL=google/gemma-4-31b-it
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key

# =====================================================
# MYSQL DATABASE
# =====================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hrbot
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=hr_voicebot

# =====================================================
# TELEPHONY — COORDINATOR & SIP TRUNK
# =====================================================
COORDINATOR_PHONE_NUMBER=+918925355704
COORDINATOR_DIAL_TIMEOUT_SECONDS=30
SIP_CALLER_ID=+918031451001
OUTBOUND_TRUNK_ID=your-sip-trunk-id
SIP_TRUNK_USERNAME=AgenticHRVoicebot
SIP_TRUNK_PASSWORD=your-sip-password

# =====================================================
# EMAIL & NOTIFICATIONS (SMTP / IMAP)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
HR_EMAIL=hr@company.com

# =====================================================
# WORKER DISPATCH & CALL BEHAVIOUR
# =====================================================
TELEPHONY_BACKEND=asterisk
WORKER_AGENT_NAME=hr-voice-agent
IDLE_HANGUP_SECONDS=60.0
RECORDING_COORDINATOR_MODE=record_all

# =====================================================
# ASTERISK ARI & AUDIOSOCKET CONFIGURATION
# =====================================================
ARI_URL=http://127.0.0.1:8088/ari
ARI_WS_URL=ws://127.0.0.1:8088/ari/events
ARI_USER=asterisk
ARI_PASSWORD=asterisk
ARI_APP_NAME=hr_voicebot

AST_BRIDGE_HOST=0.0.0.0
AST_BRIDGE_ADVERTISE_HOST=127.0.0.1
AST_BRIDGE_PORT=9090
AST_SAMPLE_RATE=8000

# =====================================================
# S3 / RECORDINGS (OPTIONAL)
# =====================================================
RECORDINGS_LOCAL_DIR=/var/recordings/hr_voicebot
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=us-east-1
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET_KEY=
