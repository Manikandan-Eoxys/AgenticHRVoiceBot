{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBuilderConfig",
  "description": "Schema contract between AgentBuilder and hr_voice_agent runtime",
  "type": "object",
  "required": [
    "schemaVersion",
    "agentId",
    "agentName",
    "goals",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the configuration schema (e.g. 1.0.0)"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the agent"
    },
    "agentName": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the voice agent"
    },
    "description": {
      "type": "string",
      "description": "Purpose and description of the agent"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived"],
      "default": "active"
    },
    "voice": {
      "type": "object",
      "properties": {
        "llmProvider": { "type": "string", "default": "ollama" },
        "llmModel": { "type": "string", "default": "google/gemma-4-31b-it" },
        "llmEndpoint": { "type": "string" },
        "sttProvider": { "type": "string", "default": "deepgram" },
        "sttLanguage": { "type": "string", "default": "en" },
        "ttsProvider": { "type": "string", "default": "cartesia" },
        "ttsModel": { "type": "string", "default": "cartesia/sonic-3" },
        "ttsVoice": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7 }
      }
    },
    "telephony": {
      "type": "object",
      "properties": {
        "outboundTrunkId": { "type": "string" },
        "coordinatorPhone": { "type": "string" },
        "sipCallerId": { "type": "string" },
        "inactivityTimeoutSec": { "type": "number", "default": 60.0 },
        "dtmfFallback": { "type": "boolean", "default": true }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "conversationWindow": { "type": "integer", "default": 10 },
        "enableScratchpad": { "type": "boolean", "default": true }
      }
    },
    "knowledgeBase": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "ragEndpoint": { "type": "string" },
        "similarityThreshold": { "type": "number", "default": 0.75 }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "trigger_phrases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "goalId", "functionName", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "goalId": { "type": "string" },
          "functionName": { "type": "string" },
          "trigger": { "type": "string" },
          "instruction": { "type": "string" },
          "parameters": {
            "type": ["object", "string", "array"]
          },
          "enabled": { "type": "boolean", "default": true },
          "dataSource": {
            "type": "object",
            "required": ["sourceType"],
            "properties": {
              "sourceType": {
                "type": "string",
                "enum": ["sql_table", "rest_api", "none"]
              },
              "tableName": { "type": "string" },
              "columns": {
                "type": "array",
                "items": { "type": "string" }
              },
              "filterColumn": { "type": "string" },
              "apiUrl": { "type": "string" },
              "method": {
                "type": "string",
                "enum": ["GET", "POST", "PUT", "DELETE"],
                "default": "GET"
              },
              "authType": {
                "type": "string",
                "enum": ["none", "bearer", "api_key", "basic"],
                "default": "none"
              },
              "authHeader": { "type": "string" },
              "secretRef": {
                "type": "string",
                "description": "Environment variable reference for secrets, e.g. ${API_KEY}"
              }
            }
          }
        }
      }
    }
  }
}
