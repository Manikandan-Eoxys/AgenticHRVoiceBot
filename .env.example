# ==============================================================================
# Agentic HR Voice Bot — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials:
#   cp .env.example .env
# ==============================================================================

# =====================================================
# LIVEKIT CLOUD / SERVER
# =====================================================
# Create project at: https://cloud.livekit.io
# Project Settings → Keys → Create new key
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Unique identity for this worker process
WORKER_AGENT_NAME=hr-voice-agent

# Model identifier for LiveKit inference agent
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it

# =====================================================
# SPEECH-TO-TEXT (STT) — DEEPGRAM
# =====================================================
# Get key at: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# =====================================================
# TEXT-TO-SPEECH (TTS)
# =====================================================
# Provider options: cartesia, deepgram, elevenlabs
TTS_PROVIDER=cartesia
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=ec1e269e-9ca0-402f-8a18-58e0e022355a

# Optional ElevenLabs configuration (if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_MODEL=eleven_turbo_v2_5

# =====================================================
# LOCAL LLM — OLLAMA
# =====================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# =====================================================
# CLOUD LLM FALLBACKS (OPTIONAL)
# =====================================================
# OpenAI
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Groq (Free fast inference: https://console.groq.com)
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# MySQL is the primary database for HR records, policies, and leaves.
# Initialize schema using: mysql -u root -p < database/hr-voicebot-schema-mysql.sql
MYSQL_HOST=localhost
MYSQL_USER=hrbot
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=hr_voicebot

# SQLite fallback path
DATABASE_PATH=database/hr.db

# =====================================================
# NOTIFICATIONS — SMTP (EMAIL)
# =====================================================
# Used for manager leave approvals, policy acknowledgements, and alerts.
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# HR department notification recipient
HR_EMAIL=hr@yourcompany.com
HR_NOTIFY_EMAIL=hr@yourcompany.com

# =====================================================
# TELEPHONY / SIP / CALL ESCALATION
# =====================================================
COORDINATOR_PHONE_NUMBER=+918925355704
LIVEKIT_OUTBOUND_TRUNK_ID=ST_your_outbound_trunk_id
IDLE_HANGUP_SECONDS=30.0

# Call recording during coordinator transfer:
#   record_all -> Record complete 3-way call (caller + agent + coordinator)
#   cutoff     -> Stop recording when transferred to coordinator
RECORDING_COORDINATOR_MODE=record_all

# SIP Trunking authentication (for Plivo / Asterisk SIP callers)
SIP_TRUNK_USERNAME=AgenticHRVoicebot
SIP_TRUNK_PASSWORD=your_sip_password
SIP_ROOM_PREFIX=plivo-hr-call

# Blocked phone numbers (comma-separated)
# BLOCKED_PHONE_NUMBERS=+1234567890,+919876543210

# =====================================================
# APPLICATION & BEHAVIOR
# =====================================================
LOG_LEVEL=INFO
AGENT_NAME=HR Buddy
COMPANY_NAME=ABC Technologies
DEFAULT_LANGUAGE=en
ENABLE_MEMORY=true
ENABLE_INTERRUPTIONS=true
ENABLE_IDENTITY_VERIFICATION=true
ENABLE_TOOL_LOGGING=true
FRONTEND_URL=http://localhost:5173

# Minimum operational coverage percentage before absence alert triggers
COVERAGE_THRESHOLD=0.08
SYNC_INTERVAL_MINUTES=15
